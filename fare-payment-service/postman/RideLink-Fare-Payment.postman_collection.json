{
  "info": {
    "_postman_id": "1d2b02ec-2735-4df3-9ccd-30fc9400f1ca",
    "name": "RideLink Fare & Payment Service",
    "description": "Fare, payment, and negative scenario requests for the RideLink service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3004" },
    { "key": "token", "value": "" },
    { "key": "passengerId", "value": "1001" },
    { "key": "driverId", "value": "2001" },
    { "key": "rideId", "value": "dddddddd-dddd-4ddd-8ddd-dddddddddddd" },
    { "key": "incompleteRideId", "value": "eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee" },
    { "key": "missingRideId", "value": "ffffffff-ffff-4fff-8fff-ffffffffffff" },
    { "key": "estimateId", "value": "cccccccc-cccc-4ccc-8ccc-cccccccccccc" },
    { "key": "paymentId", "value": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb" },
    { "key": "otherPassengerPaymentId", "value": "99999999-9999-4999-8999-999999999999" }
  ],
  "item": [
    {
      "name": "Fares",
      "item": [
        {
          "name": "Create fare estimate",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"pickupLocation\": \"Colombo Fort\",\n  \"destinationLocation\": \"Bambalapitiya\",\n  \"distanceKm\": 5.2,\n  \"durationMinutes\": 18,\n  \"surgeMultiplier\": 1.0\n}" },
            "url": "{{baseUrl}}/api/v1/fares/estimate"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Created', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.environment.set('estimateId', pm.response.json().id);"] } }]
        },
        {
          "name": "Get fare estimate",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/fares/{{estimateId}}" }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Process payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"rideId\": \"{{rideId}}\",\n  \"passengerId\": \"{{passengerId}}\",\n  \"driverId\": \"{{driverId}}\",\n  \"actualDistanceKm\": 5.2,\n  \"actualDurationMinutes\": 18,\n  \"paymentMethod\": \"SIMULATED_CARD\",\n  \"transactionRef\": \"demo-{{passengerId}}-{{rideId}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/payments"
          }
        },
        {
          "name": "Get payment",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/payments/{{paymentId}}" }
        },
        {
          "name": "Get ride payments",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/payments/ride/{{rideId}}" }
        },
        {
          "name": "Get receipt",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/payments/{{paymentId}}/receipt" }
        },
        {
          "name": "Refund payment (use an admin token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Postman demo refund\"\n}" },
            "url": "{{baseUrl}}/api/v1/payments/{{paymentId}}/refund"
          }
        }
      ]
    },
    {
      "name": "Negative Scenarios",
      "item": [
        {
          "name": "Ride not found (404)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"rideId\": \"{{missingRideId}}\",\n  \"passengerId\": \"{{passengerId}}\",\n  \"driverId\": \"{{driverId}}\",\n  \"actualDistanceKm\": 4,\n  \"actualDurationMinutes\": 12,\n  \"paymentMethod\": \"SIMULATED_CARD\",\n  \"transactionRef\": \"missing-ride-1\"\n}" },
            "url": "{{baseUrl}}/api/v1/payments"
          }
        },
        {
          "name": "Ride not completed (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"rideId\": \"{{incompleteRideId}}\",\n  \"passengerId\": \"{{passengerId}}\",\n  \"driverId\": \"{{driverId}}\",\n  \"actualDistanceKm\": 4,\n  \"actualDurationMinutes\": 12,\n  \"paymentMethod\": \"SIMULATED_CARD\",\n  \"transactionRef\": \"incomplete-ride-1\"\n}" },
            "url": "{{baseUrl}}/api/v1/payments"
          }
        },
        {
          "name": "Negative distance (422)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"rideId\": \"{{rideId}}\",\n  \"passengerId\": \"{{passengerId}}\",\n  \"driverId\": \"{{driverId}}\",\n  \"actualDistanceKm\": -1,\n  \"actualDurationMinutes\": 12,\n  \"paymentMethod\": \"SIMULATED_CARD\",\n  \"transactionRef\": \"negative-distance-1\"\n}" },
            "url": "{{baseUrl}}/api/v1/payments"
          }
        },
        {
          "name": "Forced simulated decline (402)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"rideId\": \"{{rideId}}\",\n  \"passengerId\": \"{{passengerId}}\",\n  \"driverId\": \"{{driverId}}\",\n  \"actualDistanceKm\": 5,\n  \"actualDurationMinutes\": 16,\n  \"paymentMethod\": \"SIMULATED_CARD\",\n  \"transactionRef\": \"postman-0000\"\n}" },
            "url": "{{baseUrl}}/api/v1/payments"
          }
        },
        {
          "name": "Duplicate payment for the same ride (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"rideId\": \"{{rideId}}\",\n  \"passengerId\": \"{{passengerId}}\",\n  \"driverId\": \"{{driverId}}\",\n  \"actualDistanceKm\": 5,\n  \"actualDurationMinutes\": 16,\n  \"paymentMethod\": \"SIMULATED_CARD\",\n  \"transactionRef\": \"duplicate-0001\"\n}" },
            "url": "{{baseUrl}}/api/v1/payments"
          }
        },
        {
          "name": "View another passenger's payment (403)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/payments/{{otherPassengerPaymentId}}" }
        }
      ]
    }
  ]
}
