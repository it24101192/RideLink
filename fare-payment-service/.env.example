# HTTP server
SERVER_PORT=3004

# Shared HS256 secret used by Account Service. Use the same value in both services.
FARE_JWT_SECRET=replace-with-at-least-32-random-characters

# MySQL persistence
FARE_DB_URL=jdbc:mysql://localhost:3306/ridelink_fare_db
FARE_DB_USERNAME=root
FARE_DB_PASSWORD=RideLink123!

# Interservice call and async JSONL demo event log
RIDE_SERVICE_URL=http://localhost:3003
MESSAGE_BROKER_URL=file:/tmp/ridelink-events.jsonl
MESSAGE_BROKER_TYPE=file

# Deterministic payment simulation (enable only in test environments)
PAYMENT_TEST_MODE=false
PAYMENT_TEST_OUTCOME_SUCCESS=true
