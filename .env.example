# Create a local .env from this template. Use a randomly generated secret of at least 32 bytes.
JWT_SECRET=replace-this-with-at-least-32-random-characters
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@localhost
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-private-password-at-least-12-chars
MYSQL_ROOT_PASSWORD=replace-local-mysql-password
# Use 3307 if a local MySQL installation already occupies 3306.
MYSQL_HOST_PORT=3306
RIDE_DB_PASSWORD=replace-local-postgres-password
RABBITMQ_USERNAME=ridelink
RABBITMQ_PASSWORD=replace-local-rabbitmq-password
DRIVER_SERVICE_AREA_CHECK=false
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
PAYMENT_TEST_MODE=true
PAYMENT_TEST_OUTCOME_SUCCESS=true

# Internal Docker DNS names. Smoke-test URL parameters use host URLs instead.
ACCOUNT_SERVICE_URL=http://account-service:8081
DRIVER_SERVICE_URL=http://driver-vehicle-service:3002
RIDE_SERVICE_URL=http://ride-management-service:3003
FARE_PAYMENT_SERVICE_URL=http://fare-payment-service:3004
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RIDE_EVENTS_EXCHANGE=ridelink.events
RIDE_COMPLETED_ROUTING_KEY=ride.completed
RIDE_COMPLETED_QUEUE=fare-payment.ride-completed
RIDE_EVENTS_DEAD_LETTER_EXCHANGE=ridelink.events.dlx
RIDE_COMPLETED_DEAD_LETTER_QUEUE=fare-payment.ride-completed.dlq
RIDE_EVENTS_PUBLISH_INTERVAL_MS=1000
DRIVER_SEARCH_RADIUS_KM=10

# Compose fixes DB names/users and maps MYSQL_ROOT_PASSWORD to ACCOUNT_DB_PASSWORD,
# DRIVER_DB_PASSWORD and FARE_DB_PASSWORD. RIDE_DB_PASSWORD configures PostgreSQL.
# For IDE launches set each service's *_DB_URL/USERNAME/PASSWORD with localhost
# URLs, and use localhost service/RabbitMQ addresses; see README.
# Bootstrap does not reset existing admin passwords. Database environment values
# also do not reset passwords stored in existing volumes.
# Use simple literal values: the smoke parser does not expand ${...} or escapes.
# Quote values containing whitespace or #; prefer single quotes for $ characters.
