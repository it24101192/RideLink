              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passengerId\": 1,\n  \"pickupLocation\": \"\",\n  \"destination\": \"Airport\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"Error code is VALIDATION_ERROR\", function () { pm.expect(pm.response.json().error).to.eql(\"VALIDATION_ERROR\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Get non-existent ride - not found (negative)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/rides/999999",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "rides",
                "999999"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", function () { pm.response.to.have.status(404); });",
                  "pm.test(\"Error code is RIDE_NOT_FOUND\", function () { pm.expect(pm.response.json().error).to.eql(\"RIDE_NOT_FOUND\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
