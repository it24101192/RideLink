{
  "info": {
    "name": "RideLink - Ride Management Service",
    "description": "Ride Management Service (port 8083). Run folder 1 in order. Folder 2 needs the Driver and Fare & Payment services running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Ride Management - success and negative tests (service alone)",
      "item": [
        {
          "name": "1. Create ride - success",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/rides",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "rides"
              ]
            },
            "description": "Creates a ride and stores rideId in the environment for the next requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passengerId\": 1,\n  \"pickupLocation\": \"Colombo 03\",\n  \"destination\": \"Bandaranaike International Airport\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.test(\"Status is REQUESTED\", function () { pm.expect(json.status).to.eql(\"REQUESTED\"); });",
                  "pm.environment.set(\"rideId\", json.rideId);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Get ride by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/rides/{{rideId}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "rides",
                "{{rideId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"rideId matches\", function () { pm.expect(pm.response.json().rideId).to.eql(parseInt(pm.environment.get(\"rideId\"))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "3. List rides by passenger",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/rides?passengerId=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "rides"
              ],
              "query": [
                {
                  "key": "passengerId",
                  "value": "1"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is an array\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Accept ride from REQUESTED - invalid transition (negative)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/rides/{{rideId}}/accept",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "rides",
                "{{rideId}}",
                "accept"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", function () { pm.response.to.have.status(409); });",
                  "pm.test(\"Error code is INVALID_STATUS_TRANSITION\", function () { pm.expect(pm.response.json().error).to.eql(\"INVALID_STATUS_TRANSITION\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Cancel ride - success",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/rides/{{rideId}}/cancel",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "rides",
                "{{rideId}}",
                "cancel"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Passenger changed mind\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Status is CANCELLED\", function () { pm.expect(pm.response.json().status).to.eql(\"CANCELLED\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Cancel ride again - invalid transition (negative)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
